@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">

                        <h2 class="fw-bold mb-2">
                            Privacy Policy
                        </h2>

                        <p class="text-muted mb-0">
                            Information about privacy and data handling within Cartiva.
                        </p>

                    </div>

                    <hr />

                    <div class="mt-4">

                        <h5 class="fw-bold">
                            Information We Collect
                        </h5>

                        <p class="text-muted">
                            Cartiva may store account and application data required
                            to provide its authentication, product and cart
                            management functionality.
                        </p>

                    </div>

                    <div class="mt-4">

                        <h5 class="fw-bold">
                            Account Information
                        </h5>

                        <p class="text-muted">
                            Registered account information is used to authenticate
                            users and provide access to the application's features.
                        </p>

                    </div>

                    <div class="mt-4">

                        <h5 class="fw-bold">
                            Data Security
                        </h5>

                        <p class="text-muted">
                            Cartiva uses authenticated API communication and
                            protected application access to help safeguard
                            application data.
                        </p>

                    </div>

                    <div class="mt-4">

                        <h5 class="fw-bold">
                            Contact
                        </h5>

                        <p class="text-muted mb-0">
                            For privacy-related questions, please contact the
                            appropriate Cartiva application administrator.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>