<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cartiva</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Cartiva.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">

            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold fs-4 text-primary"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Cartiva
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">
                                Products
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cart"
                               asp-action="Index">
                                Cart
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="User"
                               asp-action="Index">
                                Users
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex align-items-center gap-2">

                        <span class="text-muted small d-none d-md-inline">
                            Cartiva
                        </span>

                        <a class="btn btn-outline-danger btn-sm px-3"
                           asp-controller="Account"
                           asp-action="Logout">
                            Logout
                        </a>

                    </div>

                </div>

            </div>

        </nav>
    </header>


    <!-- MAIN CONTENT -->
    <main role="main">
        @RenderBody()
    </main>


    <!-- FOOTER -->
    <footer class="border-top bg-white mt-5">

        <div class="container-fluid px-4 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <span class="text-muted small">
                    © 2026 Cartiva. All rights reserved.
                </span>

                <a class="text-muted small text-decoration-none"
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>